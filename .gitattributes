* text=auto eol=lf

*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.c     text eol=lf
*.cmake text eol=lf
*.json  text eol=lf
*.md    text eol=lf
CMakeLists.txt text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png  binary
*.dll  binary
*.lib  binary
*.pdf  binary

# Test files: Git LFS keeps them out of the history, a checkout fetches them.
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
