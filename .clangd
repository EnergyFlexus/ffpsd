# Third-party code under vendor/ is not ours to fix: no diagnostics, no background index. The headers of
# cmake/prefix/ are forced into that code and have its include paths only there.
If:
  PathMatch: (vendor|cmake/prefix)/.*
Diagnostics:
  Suppress: "*"
  ClangTidy:
    Remove: "*"
Index:
  Background: Skip
---
# pip builds the Python module outside the presets; scripts/python_compile_commands.py writes its flags here.
If:
  PathMatch: bindings/python/.*
CompileFlags:
  CompilationDatabase: build/python-clangd
