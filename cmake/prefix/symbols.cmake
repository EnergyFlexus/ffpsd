# The symbols ARCHIVE defines for other objects, listed with DUMPBIN or NM.
# MODE=check fails on any without the ffpsd_ prefix; MODE=update adds those to the renames in HEADER.

# Not the vendored libraries': C++ and constants of MSVC, which C names cannot spell, C++ of GCC and Clang,
# and what the compiler and the CRT headers put into any object.
set(ignored "[?@]|^(_Z|DW\\.ref\\.|__gnu_lto_|__clang_call_terminate$|__local_stdio_|__isa_available|_Avx2WmemEnabled|wmem|_?_?v?(s|f|sn|ss|sc)?(printf|scanf)(_s)?(_l)?$|_?(ctime|difftime|gmtime|localtime|mkgmtime|mktime|time|timespec_get)(_s)?$)")

function(list_symbols variable archive)
    set(listing "${archive}.symbols.txt")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "${archive} is not built.")
    endif()
    if(DUMPBIN)
        execute_process(COMMAND "${DUMPBIN}" /dump /symbols "${archive}" OUTPUT_FILE "${listing}" COMMAND_ERROR_IS_FATAL ANY)
        file(STRINGS "${listing}" symbols REGEX " SECT[0-9A-F]+ [^|]* External +\\| ")
        list(TRANSFORM symbols REPLACE ".* External +\\| ([^ ]+).*" "\\1")
    else()
        # nm fails on objects it cannot read, such as those for LTO without the plugin; the rest is still listed.
        execute_process(COMMAND "${NM}" -g "${archive}" OUTPUT_FILE "${listing}" ERROR_QUIET)
        file(STRINGS "${listing}" symbols REGEX "^[0-9a-fA-F]+ [A-TV-Z] ")
        list(TRANSFORM symbols REPLACE "^[0-9a-fA-F]+ . " "")
        if(LEADING_UNDERSCORE)
            # "^_" alone would match again after each replacement and strip every leading underscore.
            list(TRANSFORM symbols REPLACE "^_(.*)" "\\1")
        endif()
    endif()
    file(REMOVE "${listing}")
    list(REMOVE_DUPLICATES symbols)
    list(FILTER symbols EXCLUDE REGEX "${ignored}")
    set(${variable} "${symbols}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "check")
    list_symbols(symbols "${ARCHIVE}")
    set(foreign "${symbols}")
    list(FILTER foreign EXCLUDE REGEX "^ffpsd_")
    if(symbols STREQUAL foreign)
        message(FATAL_ERROR "No ffpsd_ symbols found in ${ARCHIVE}: the listing did not work.")
    endif()
    if(foreign)
        list(SORT foreign)
        list(JOIN foreign "\n  " names)
        message(FATAL_ERROR "Symbols of ${ARCHIVE} without the ffpsd_ prefix:\n  ${names}\n"
                            "Run python scripts/update_prefixes.py on this system.")
    endif()
elseif(MODE STREQUAL "update")
    file(READ "${HEADER}" header)
    string(REPLACE "\r\n" "\n" header "${header}")
    string(REGEX MATCHALL "#define [A-Za-z0-9_]+ ffpsd_" renames "${header}")
    list(TRANSFORM renames REPLACE "#define ([A-Za-z0-9_]+) ffpsd_" "\\1")

    list_symbols(symbols "${ARCHIVE}")
    list(FILTER symbols EXCLUDE REGEX "^ffpsd_")
    list(APPEND renames ${symbols})
    list(REMOVE_DUPLICATES renames)
    list(SORT renames)

    # The renames go in one block right after the include guard, before anything they must apply to.
    list(TRANSFORM renames REPLACE "(.+)" "#define \\1 ffpsd_\\1\n")
    list(JOIN renames "" block)
    if(block)
        string(APPEND block "\n")
    endif()
    string(REGEX REPLACE "(#define [A-Za-z0-9_]+ ffpsd_[A-Za-z0-9_]+\n)+\n?" "" rest "${header}")
    string(REGEX MATCH "#define FFPSD_PREFIX_[A-Z0-9_]+_H\n\n" guard "${rest}")
    if(NOT guard)
        message(FATAL_ERROR "${HEADER} has no include guard followed by an empty line.")
    endif()
    string(FIND "${rest}" "${guard}" at)
    string(LENGTH "${guard}" length)
    math(EXPR at "${at} + ${length}")
    string(SUBSTRING "${rest}" 0 ${at} head)
    string(SUBSTRING "${rest}" ${at} -1 tail)
    set(updated "${head}${block}${tail}")
    if(NOT updated STREQUAL header)
        # file(WRITE) would end the lines with CRLF on Windows.
        file(CONFIGURE OUTPUT "${HEADER}" CONTENT "${updated}" @ONLY NEWLINE_STYLE LF)
        message(STATUS "Updated ${HEADER}")
    endif()
else()
    message(FATAL_ERROR "MODE must be check or update.")
endif()
